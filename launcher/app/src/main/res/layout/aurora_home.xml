<?xml version="1.0" encoding="utf-8"?>
<!-- Gleb's fork: the Aurora home screen (AuroraHome). Sizes are dp at the TV's 2x density: half the mock's px. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aurora_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="56dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/aurora_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost_regular"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#FFF3F6FB"
                android:textSize="42sp" />

            <TextClock
                android:id="@+id/aurora_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:paddingStart="2.5dp"
                android:fontFamily="@font/jost_regular"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="#FFDCE3EE"
                android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/aurora_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="9dp"
            android:background="@drawable/aurora_bar"
            android:padding="3dp">

            <View
                android:id="@+id/aurora_pill"
                android:layout_width="0dp"
                android:layout_height="30dp" />

            <LinearLayout
                android:id="@+id/aurora_tab_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/aurora_tab_home" style="@style/AuroraTab" android:text="@string/aurora_home" />
                <TextView android:id="@+id/aurora_tab_apps" style="@style/AuroraTab" android:text="@string/aurora_apps" />
                <TextView android:id="@+id/aurora_tab_settings" style="@style/AuroraTab" android:text="@string/aurora_settings" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/aurora_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="5dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/aurora_pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="118dp"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/aurora_page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aurora_apps_title"
                style="@style/AuroraHeading"
                android:text="@string/aurora_apps" />

            <LinearLayout
                android:id="@+id/aurora_app_row"
                style="@style/AuroraRow" />

            <TextView
                android:id="@+id/aurora_watch_title"
                style="@style/AuroraHeading"
                android:layout_marginTop="22dp"
                android:text="@string/aurora_continue"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/aurora_watch_row"
                style="@style/AuroraRow"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Scrolling pages clip at their top edge and fade there, so rows never run over the clock and the bar. -->
        <com.gathin.tvhome.AuroraScroll
            android:id="@+id/aurora_page_apps"
            style="@style/AuroraScroll"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/aurora_apps_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <TextView style="@style/AuroraHeading" android:text="@string/aurora_all_apps" />
            </LinearLayout>
        </com.gathin.tvhome.AuroraScroll>

        <FrameLayout
            android:id="@+id/aurora_page_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <com.gathin.tvhome.AuroraScroll
                android:id="@+id/aurora_settings_scroll"
                style="@style/AuroraScroll">

                <LinearLayout
                    android:id="@+id/aurora_settings_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical" />
            </com.gathin.tvhome.AuroraScroll>

            <com.gathin.tvhome.AuroraScroll
                android:id="@+id/aurora_picker"
                style="@style/AuroraScroll"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/aurora_picker_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical" />
            </com.gathin.tvhome.AuroraScroll>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
