    <style name="AuroraTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">17dp</item>
        <item name="android:paddingEnd">17dp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFD9E0EC</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AuroraHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/jost_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFF3F6FB</item>
    </style>

    <style name="AuroraScroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">-14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:clipToPadding">true</item>
        <item name="android:requiresFadingEdge">vertical</item>
        <item name="android:fadingEdgeLength">30dp</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="AuroraRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">51.5dp</item>
        <item name="android:paddingEnd">51.5dp</item>
    </style>

    <style name="AuroraCardTitle" parent="AuroraButtonTitle">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="AuroraCardSub" parent="AuroraButtonSub">
        <item name="android:textSize">9.5sp</item>
    </style>

    <style name="AuroraButtonTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/jost_medium</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">#FFF3F6FB</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="AuroraButtonSub" parent="AuroraButtonTitle">
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">#FFC3CBD9</item>
    </style>
</resources>
